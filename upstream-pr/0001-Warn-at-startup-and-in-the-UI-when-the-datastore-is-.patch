diff --git a/changedetectionio/tests/unit/test_datastore_storage_check.py b/changedetectionio/tests/unit/test_datastore_storage_check.py
new file mode 100644
index 00000000..299a46b4
--- /dev/null
+++ b/changedetectionio/tests/unit/test_datastore_storage_check.py
@@ -0,0 +1,73 @@
+"""
+Unit tests for changedetectionio.datastore_checks
+
+Run: pytest changedetectionio/tests/unit/test_datastore_storage_check.py
+"""
+import pytest
+
+from changedetectionio.datastore_checks import (
+    datastore_storage_warning,
+    mount_for_path,
+    parse_mountinfo,
+)
+
+# Container started WITHOUT a volume: /datastore only exists in the overlay root
+MOUNTINFO_NO_VOLUME = """\
+1523 1402 0:310 / / rw,relatime master:612 - overlay overlay rw,lowerdir=/var/lib/docker/overlay2/l/A:/var/lib/docker/overlay2/l/B,upperdir=/var/lib/docker/overlay2/x/diff,workdir=/var/lib/docker/overlay2/x/work
+1524 1523 0:313 / /proc rw,nosuid,nodev,noexec,relatime - proc proc rw
+1525 1523 0:314 / /dev rw,nosuid - tmpfs tmpfs rw,size=65536k,mode=755
+1531 1523 254:1 /var/lib/docker/containers/abc/resolv.conf /etc/resolv.conf rw,relatime - ext4 /dev/vda1 rw
+1532 1523 254:1 /var/lib/docker/containers/abc/hostname /etc/hostname rw,relatime - ext4 /dev/vda1 rw
+"""
+
+# Same container WITH `-v changedetection-data:/datastore` (named volume)
+MOUNTINFO_NAMED_VOLUME = MOUNTINFO_NO_VOLUME + (
+    "1533 1523 254:1 /var/lib/docker/volumes/changedetection-data/_data /datastore rw,relatime master:1 - ext4 /dev/vda1 rw\n"
+)
+
+# Bind mount with a space in the host path is escaped as \040, target is a sub-path
+MOUNTINFO_BIND_SUBDIR = MOUNTINFO_NO_VOLUME + (
+    "1534 1523 254:1 /srv/my\\040data /data rw,relatime - ext4 /dev/vda1 rw\n"
+)
+
+
+def test_parse_mountinfo():
+    mounts = parse_mountinfo(MOUNTINFO_NAMED_VOLUME)
+    assert ("/", "overlay") in mounts
+    assert ("/datastore", "ext4") in mounts
+
+
+def test_mount_for_path_longest_prefix_wins():
+    mounts = parse_mountinfo(MOUNTINFO_NAMED_VOLUME)
+    assert mount_for_path("/datastore", mounts) == ("/datastore", "ext4")
+    assert mount_for_path("/datastore/abc/watch.json", mounts) == ("/datastore", "ext4")
+    # A sibling directory with a shared prefix must NOT match /datastore
+    assert mount_for_path("/datastore2", mounts) == ("/", "overlay")
+
+
+def test_warns_when_datastore_is_in_container_layer():
+    msg = datastore_storage_warning("/datastore", mountinfo_text=MOUNTINFO_NO_VOLUME, inside_container=True)
+    assert msg and "/datastore" in msg and "re-created" in msg
+
+
+def test_no_warning_with_named_volume():
+    assert datastore_storage_warning("/datastore", mountinfo_text=MOUNTINFO_NAMED_VOLUME, inside_container=True) is None
+
+
+def test_no_warning_for_subdir_of_bind_mount():
+    assert datastore_storage_warning("/data/changedetection", mountinfo_text=MOUNTINFO_BIND_SUBDIR, inside_container=True) is None
+
+
+def test_no_warning_outside_a_container():
+    # pip installs on a normal host write to a real disk, nothing to warn about
+    assert datastore_storage_warning("/datastore", mountinfo_text=MOUNTINFO_NO_VOLUME, inside_container=False) is None
+
+
+def test_can_be_disabled(monkeypatch):
+    monkeypatch.setenv("DISABLE_DATASTORE_STORAGE_CHECK", "true")
+    assert datastore_storage_warning("/datastore", mountinfo_text=MOUNTINFO_NO_VOLUME, inside_container=True) is None
+
+
+@pytest.mark.parametrize("bad", ["", "garbage line without separator\n"])
+def test_unparseable_mountinfo_is_silent(bad):
+    assert datastore_storage_warning("/datastore", mountinfo_text=bad, inside_container=True) is None
