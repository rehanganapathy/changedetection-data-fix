diff --git a/changedetectionio/datastore_checks.py b/changedetectionio/datastore_checks.py
new file mode 100644
index 00000000..71f11329
--- /dev/null
+++ b/changedetectionio/datastore_checks.py
@@ -0,0 +1,102 @@
+"""
+Startup check: is the datastore on storage that survives the container being re-created?
+
+The official Docker image does not declare a VOLUME for /datastore. If the container is
+started without `-v something:/datastore` (or the volumes: entry is dropped from a compose
+file / a PaaS template), every watch, filter and setting is written into the container's
+writable layer. Everything works and even survives `docker restart`, but the next
+`docker compose up` with a new image, a Watchtower/Portainer/Coolify redeploy or a
+`docker rm` silently discards all of it. From the user's side this looks like
+"my watches and fields randomly disappear".
+
+This module detects that situation (Linux only, read-only, no side effects) so it can be
+logged loudly at startup and shown in the UI.
+
+Set DISABLE_DATASTORE_STORAGE_CHECK=true to silence it (for example in CI).
+"""
+import os
+import re
+
+from changedetectionio.strtobool import strtobool
+
+# Root filesystems that are thrown away together with the container
+EPHEMERAL_ROOT_FSTYPES = {"overlay", "overlayfs", "aufs", "fuse-overlayfs"}
+
+CONTAINER_MARKERS = ("/.dockerenv", "/run/.containerenv")
+
+
+_OCTAL_ESCAPE = re.compile(r"\\([0-7]{3})")
+
+
+def _unescape_mountinfo(path):
+    # /proc/self/mountinfo escapes space, tab, newline and backslash as octal (\040 etc.)
+    # Only decode those, so non-ASCII paths are left intact.
+    return _OCTAL_ESCAPE.sub(lambda m: chr(int(m.group(1), 8)), path)
+
+
+def parse_mountinfo(text):
+    """Return a list of (mount_point, fstype) from /proc/self/mountinfo content."""
+    mounts = []
+    for line in text.splitlines():
+        if " - " not in line:
+            continue
+        pre, post = line.split(" - ", 1)
+        pre_fields = pre.split()
+        post_fields = post.split()
+        if len(pre_fields) < 5 or not post_fields:
+            continue
+        mounts.append((_unescape_mountinfo(pre_fields[4]), post_fields[0]))
+    return mounts
+
+
+def mount_for_path(path, mounts):
+    """The (mount_point, fstype) that `path` lives on: the longest mount point prefixing it."""
+    path = os.path.normpath(path)
+    best = None
+    for mount_point, fstype in mounts:
+        mp = os.path.normpath(mount_point)
+        if path == mp or path.startswith(mp.rstrip("/") + "/") or mp == "/":
+            if best is None or len(mp) > len(os.path.normpath(best[0])):
+                best = (mount_point, fstype)
+    return best
+
+
+def in_container():
+    return any(os.path.exists(m) for m in CONTAINER_MARKERS)
+
+
+def datastore_storage_warning(datastore_path, mountinfo_text=None, inside_container=None):
+    """
+    Return a human readable warning if `datastore_path` is stored in the container's
+    throw-away root filesystem, otherwise None.
+
+    mountinfo_text / inside_container exist so the logic can be unit tested.
+    """
+    if strtobool(os.getenv("DISABLE_DATASTORE_STORAGE_CHECK", "false")):
+        return None
+
+    if inside_container is None:
+        inside_container = in_container()
+    if not inside_container:
+        return None
+
+    if mountinfo_text is None:
+        try:
+            with open("/proc/self/mountinfo", "r", encoding="utf-8") as f:
+                mountinfo_text = f.read()
+        except OSError:
+            return None
+
+    mount = mount_for_path(os.path.realpath(datastore_path), parse_mountinfo(mountinfo_text))
+    if not mount:
+        return None
+
+    mount_point, fstype = mount
+    if os.path.normpath(mount_point) == "/" and fstype in EPHEMERAL_ROOT_FSTYPES:
+        return (
+            f"The datastore '{datastore_path}' is not on a volume, it is inside the container's "
+            f"temporary filesystem. All watches and settings will be lost when this container is "
+            f"re-created (image update, 'docker compose up', redeploy). "
+            f"Mount a volume, for example: -v changedetection-data:{datastore_path}"
+        )
+    return None
