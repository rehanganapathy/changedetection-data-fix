{$DOMAIN} {
	encode gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	# Tell well-behaved crawlers to stay out entirely
	handle /robots.txt {
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# Everything else goes to changedetection.io
	# (Caddy already sends X-Forwarded-For/-Proto/-Host to the upstream by default)
	handle {
		reverse_proxy changedetection:5000
	}
}
